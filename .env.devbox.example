# Dev container variables (devbox). Copy to .env.devbox (gitignored):
#   cp .env.devbox.example .env.devbox
#
# The devcontainers CLI does not read this file: use ./scripts/devbox-up.sh,
# which sources it before `devcontainer up`. Nothing here is required: without
# .env.devbox the dev container uses plain Ubuntu 24.04.

# Personal devbox image (zsh/tmux/NeoVim LazyVim/lazygit/OpenCode + your own
# configs, the `dev` user, `onstart` and `devbox-agent-relay`). Uncomment to use
# it instead of the default Ubuntu image.
# DEVBOX_BASE_IMAGE=ghcr.io/busymoood/exmaple-personal-image:main
