# Dev container variables (devbox). Copy to .env.devbox (gitignored):
#   cp .env.devbox.example .env.devbox
#
# The devcontainers CLI does not read this file: run ./scripts/devbox-up.sh,
# which exports these variables before `devcontainer up`.

# Dotfiles repository (zsh/tmux/ssh). Current placeholder: the image repo has
# no zsh/.zshrc or tmux/.tmux.conf, so nothing is linked yet.
DOTFILES_REPO=git@github.com:busymoood/dotfiles-docker.git

# NeoVim/LazyVim configuration (private repository -> SSH agent required;
# "" = bare nvim).
NVIM_CONFIG_REPO=git@github.com:Thejulfi/lazyvim-config.git

# Optional — SSH agent TCP relay target (Docker Desktop).
# DEVBOX_SSH_RELAY_TARGET=host.docker.internal:4242
# Optional — SSH agent socket inside the container.
# DEVBOX_SSH_AUTH_SOCK=/tmp/ssh-agent.sock
