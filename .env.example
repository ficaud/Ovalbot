# Image tag to deploy. Pin to a specific version for reproducibility (e.g. v1.0.0)
# or use `latest` to track the most recent release.
OVALBOT_VERSION=latest

# Host port exposed on the machine running the container.
PORT=3000

# Welcome email (Resend). Set RESEND_ENABLED=true and provide a key to actually send.
# Resend only delivers to real recipients from a verified domain; use the sandbox
# sender below for testing.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=OvalBot <onboarding@ficaud.xyz>

# Directory holding the HTML email templates (welcome.html, match_alert.html).
# The image ships defaults at /app/templates. To override them without
# rebuilding, mount a local `templates/` folder over /app/templates (see
# docker-compose.yml) and keep TEMPLATE_DIR=/app/templates.
TEMPLATE_DIR=/app/templates

# Telegram notifications (match alerts). Set TELEGRAM_ENABLED=true and provide a
# bot token to actually send. The webhook URL must be publicly reachable over
# HTTPS so Telegram can deliver account-linking updates.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
